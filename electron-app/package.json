{
  "name": "messenger-electron-app",
  "version": "0.1.0",
  "private": true,
  "description": "Internal messenger desktop client",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc && electron-vite build",
    "build:web": "tsc --noEmit && vite build --config vite.web.config.ts",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "dist": "npm run build && electron-builder",
    "dist:release": "node scripts/release.cjs",
    "test:desktop": "npm run build && electron scripts/desktop-smoke.cjs",
    "test:typing": "npm run build && electron scripts/desktop-smoke.cjs --typing",
    "test:notifications": "npm run build && electron scripts/notification-smoke.cjs",
    "test:schedules": "npm run build:web && node scripts/schedule-smoke.cjs"
  },
  "dependencies": {
    "@stomp/stompjs": "^7.2.1",
    "@tanstack/react-query": "^5.90.2",
    "axios": "^1.12.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io-client": "^4.8.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "vite": "^7.1.10"
  },
  "build": {
    "appId": "com.company.messenger",
    "productName": "Internal Messenger",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**",
      "dist-electron/**",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "resources/icon.icns",
      "hardenedRuntime": true,
      "notarize": false
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "resources/icon.ico"
    },
    "extraResources": [
      {
        "from": "resources",
        "to": "assets"
      },
      {
        "from": "messenger.properties.example",
        "to": "messenger.properties.example"
      }
    ]
  }
}
